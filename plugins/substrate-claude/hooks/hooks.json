{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:substrate-claude:substrate-memory",
            "tool": "memory_turn_context",
            "timeout": 5,
            "input": {
              "session_id": "${session_id}",
              "prompt": "${prompt}",
              "platform": "claude"
            }
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/substrate_sync.py\" --host claude --offer-check 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/substrate_sync.py\" --host claude --offer-check 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:substrate-claude:substrate-memory",
            "tool": "memory_capture_tool",
            "timeout": 5,
            "input": {
              "session_id": "${session_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}",
              "platform": "claude"
            }
          }
        ]
      },
      {
        "matcher": "mcp__plugin_substrate-claude_substrate-memory__authenticate",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/substrate_sync.py\" --host claude --signin-start 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/substrate_sync.py\" --host claude --signin-start 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:substrate-claude:substrate-memory",
            "tool": "memory_capture_turn",
            "timeout": 5,
            "input": {
              "session_id": "${session_id}",
              "assistant_message": "${last_assistant_message}",
              "agent_context": "main",
              "platform": "claude"
            }
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/substrate_sync.py\" --host claude --stop-check 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/substrate_sync.py\" --host claude --stop-check 2>/dev/null || true",
            "timeout": 45
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:substrate-claude:substrate-memory",
            "tool": "memory_session_boundary",
            "timeout": 5,
            "input": {
              "session_id": "${session_id}",
              "boundary": "compact",
              "platform": "claude"
            }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/substrate_sync.py\" --host claude --update-check 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/substrate_sync.py\" --host claude --update-check 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
